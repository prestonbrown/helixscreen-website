---
import themes from '../data/themes.generated.json';
---
<div class="hx-switcher">
  <label class="hx-switcher-field">
    <span class="hx-sr-only">Theme</span>
    <select class="hx-theme-select">
      {themes.map((t) => (
        <option value={t.slug} data-modes={t.modes.join(',')}>{t.name}</option>
      ))}
    </select>
  </label>
  <button class="hx-mode-toggle" type="button" aria-label="Toggle light and dark mode">
    <span class="hx-mode-label">dark</span>
  </button>
</div>

<style>
  /* Self-contained on purpose: this component renders in both the marketing
   * bundle and the Starlight docs bundle, which do not share Tailwind utilities. */
  .hx-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 0.75rem;
  }
  .hx-switcher-field { display: inline-flex; }
  .hx-switcher select,
  .hx-switcher button {
    background: transparent;
    color: var(--hx-text-muted);
    border: var(--hx-border-width) solid var(--hx-border);
    border-radius: var(--hx-radius);
    padding: 0.25rem 0.5rem;
    font: inherit;
    cursor: pointer;
  }
  .hx-switcher button[disabled] { cursor: default; opacity: 0.4; }
  .hx-sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>

<script>
  // Starlight renders ThemeSelect in two places — the desktop header and the
  // mobile drawer — so this component can exist more than once per page. It
  // therefore carries no ids: every lookup is scoped to an instance, and a
  // change to one instance updates them all.
  const roots = Array.from(document.querySelectorAll('.hx-switcher'));
  const html = document.documentElement;

  function modesFor(slug) {
    const opt = roots[0]?.querySelector(`option[value="${slug}"]`);
    return (opt?.dataset.modes ?? 'dark').split(',');
  }

  function apply(theme, mode) {
    const modes = modesFor(theme);
    const resolved = modes.includes(mode) ? mode : modes[0];
    html.setAttribute('data-hx-theme', theme);
    html.setAttribute('data-theme', resolved);

    for (const root of roots) {
      const select = root.querySelector('.hx-theme-select');
      const toggle = root.querySelector('.hx-mode-toggle');
      const label = root.querySelector('.hx-mode-label');
      if (select) select.value = theme;
      if (label) label.textContent = resolved;
      // A dark-only theme cannot be toggled; say so rather than no-op silently.
      if (toggle) toggle.disabled = modes.length === 1;
    }

    try {
      // Only touch storage for keys that actually changed — an unconditional
      // rewrite on every mount is itself the split-write window a stale
      // theme/mode pairing could land in.
      if (localStorage.getItem('hx-theme') !== theme) localStorage.setItem('hx-theme', theme);
      if (localStorage.getItem('hx-mode') !== resolved) localStorage.setItem('hx-mode', resolved);
    } catch (e) { /* private mode: choice just won't persist */ }
  }

  apply(html.getAttribute('data-hx-theme') ?? 'helixscreen', html.getAttribute('data-theme') ?? 'dark');

  for (const root of roots) {
    root.querySelector('.hx-theme-select')?.addEventListener('change', (event) => {
      apply(event.target.value, html.getAttribute('data-theme'));
    });
    root.querySelector('.hx-mode-toggle')?.addEventListener('click', () => {
      apply(html.getAttribute('data-hx-theme'), html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });
  }
</script>
