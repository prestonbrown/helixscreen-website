---
// Starlight's ThemeSelect slot in the docs header: the documentation version
// picker from starlight-versions, then the site-wide theme switcher.
import VersionSelect from 'starlight-versions/components/VersionSelect.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
---
<VersionSelect />
<ThemeSwitcher />

<style is:global>
  /* The plugin fixes the select at 6.5em, which cuts off "1.0 (stable)". Size it
   * to its labels and draw it like the theme switcher beside it. The attribute
   * selector outranks the plugin's scoped rule without !important. */
  starlight-version-select select[autocomplete] {
    width: auto;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    color: var(--hx-text-muted);
    border: var(--hx-border-width) solid var(--hx-border);
    border-radius: var(--hx-radius);
    padding-block: 0.25rem;
    padding-inline: 1.6rem 1.6rem;
  }
  starlight-version-select label svg.icon.label-icon { inset-inline-start: 0.45rem; }
  starlight-version-select label svg.icon.caret-icon { inset-inline-end: 0.3rem; }
</style>
