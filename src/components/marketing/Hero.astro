---
import { Image } from 'astro:assets';
import heroShot from '../../assets/images/screenshots/hero-print-status.png';
import StatRow from './StatRow.astro';
import GuideLinks from './GuideLinks.astro';
import SpecGrid from './SpecGrid.astro';
import themes from '../../data/themes.generated.json';
import printers from '../../data/printers.generated.json';
import backends from '../../data/backends.generated.json';
import whatsnew from '../../data/whatsnew.generated.json';

// repo.generated.json is not committed; a build that skipped prebuild has none.
const repo = Object.values(
  import.meta.glob<{ commitsDisplay: string | null }>('../../data/repo.generated.json', { eager: true, import: 'default' }),
)[0];

const [major, minor] = whatsnew.version.split('.').map(Number);

// The announcement shows only while the built docs are the line it announces,
// so a deploy that trails the release tag never announces a version the badge
// beside it does not yet read.
const ANNOUNCED_SERIES = '1.1';
const isLaunch = `${major}.${minor}` === ANNOUNCED_SERIES;
const RELEASE_URL = 'https://github.com/prestonbrown/helixscreen/releases/tag/v1.1.0';
const series = Number.isFinite(major) && Number.isFinite(minor) ? `${major}.${minor}` : null;

const stats = [
  ...(repo?.commitsDisplay ? [{ value: repo.commitsDisplay, label: 'commits since October 2025' }] : []),
  { value: '~15 MB', label: 'resident on an armv7 printer board' },
  { value: String(printers.count), label: 'printers detected automatically' },
];

const spec = [
  { k: 'RAM', v: '~15 MB' },
  { k: 'Disk', v: '~75-115 MB' },
  { k: 'Requires', v: 'Klipper + Moonraker' },
  { k: 'X11 / Wayland', v: 'not required', tone: 'subtle' as const },
  { k: 'Panels', v: '30+' },
  { k: 'Themes', v: String(themes.length) },
  { k: 'Multi-material', v: String(backends.count) },
  { k: 'License', v: 'GPL-3.0' },
];

const install = 'curl -sSL https://releases.helixscreen.org/install.sh | sh';
---
<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-14">
  <p class="ui text-xs uppercase tracking-[0.16em] text-warn mb-5">
    Klipper touch interface{series && ` · ${series}`}
  </p>
  <h1 class="text-4xl md:text-5xl leading-[1.1] mb-6">
    The Klipper touchscreen for multi-material printers
  </h1>
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-10 lg:items-start">
  <div class="max-w-3xl">
    <p class="text-lg leading-relaxed text-ink-muted max-w-[56ch] mb-8">
      HelixScreen replaces KlipperScreen or your printer's factory screen, in about 15 MB of
      RAM and with no X11. It has screens for {backends.count} <a href="/guide/filament/#supported-filament-systems" class="text-secondary underline underline-offset-2">filament systems</a>, among them
      Happy Hare, AFC, ACE, CFS and IFS. <a href="/guide/calibration/#input-shaper" class="text-secondary underline underline-offset-2">Input shaper</a> with live graphs, belt tension
      and <a href="/guide/calibration/#pressure-advance-tuning-test-tower" class="text-secondary underline underline-offset-2">pressure advance</a> towers run from the touchscreen. Setup finds your printer and picks a layout for
      your display, and the home screen is a grid of widgets you can rearrange.
    </p>
    <GuideLinks class="-mt-5 mb-8" links={[
      { href: '/guide/getting-started/#first-time-setup', label: 'First-Time Setup' },
      { href: '/guide/supported-printers/', label: 'Supported Printers' },
      { href: '/guide/', label: 'User Guide' },
    ]} />

    {isLaunch && (
      <p class="text-base leading-relaxed text-ink-muted max-w-[56ch] mb-8 border-l-2 border-l-warn pl-4">
        <strong class="font-semibold text-ink">HelixScreen 1.1 is out.</strong>{' '}
        It adds a Print Status screen built around a picture of your printer, a finer home screen
        grid with widgets that show more as you make them bigger, layouts for portrait and ultrawide panels, <a href="/guide/calibration/#tuning-your-belts" class="text-secondary underline underline-offset-2">guided belt
        tuning</a>, pressure advance test towers, OpenAMS and multi-unit ACE support, and <a href="/dev/contributing/plugins/" class="text-secondary underline underline-offset-2">Lua
        plugins</a>. Upgrading from 1.0 keeps your settings and converts your home layout as closely as it can; a few widgets may need moving back.
        <span class="block mt-2">
          <a href="/guide/release-notes-1-1/" class="text-secondary underline underline-offset-2">1.1 release notes</a>
          <span class="mx-2" aria-hidden="true">·</span>
          <a href="/whats-new/" class="text-secondary underline underline-offset-2">What's new</a>
          <span class="mx-2" aria-hidden="true">·</span>
          <a href={RELEASE_URL} class="text-secondary underline underline-offset-2">Release on GitHub</a>
        </span>
      </p>
    )}
  </div>
  <div class="plinth mb-10 lg:mb-8 lg:mt-1">
    <Image
      src={heroShot}
      alt="Print Status on an 800 by 480 screen: the model preview and progress on the left, a picture of the printer with a chip on each heater and fan, the loaded spools, and the Pause, Tune and Cancel buttons"
      widths={[480, 800, 1200]}
      sizes="(max-width: 1024px) 92vw, 44vw"
      loading="eager"
    />
  </div>
  </div>

  <SpecGrid rows={spec} />

  <div class="max-w-3xl">
    {/* The command wraps rather than scrolling: a scroll container hides most of
        the URL behind a scrollbar, and the whole point is to read it before
        piping it to a shell. */}
    <div class="mt-8 flex items-start gap-3 border border-hairline border-l-2 border-l-alert rounded-[var(--hx-radius)] bg-overlay px-4 py-3">
      <span class="font-mono text-sm text-ink-muted select-none">$</span>
      <code id="hero-install-command" tabindex="0" class="font-mono text-sm text-ink flex-1 leading-relaxed [overflow-wrap:anywhere]">{install}</code>
      <button id="hero-copy-btn" type="button" aria-live="polite" class="ui text-xs uppercase tracking-[0.1em] text-ink-muted hover:text-ink shrink-0">Copy</button>
    </div>
    <p class="ui text-sm text-ink-muted mt-4">
      If you would rather read before running anything, <a href="/installation/" class="text-secondary underline underline-offset-2">the install guide</a> covers every supported board, plus running the screen on a separate device.
    </p>
  </div>

  <div class="mt-12">
    <StatRow items={stats} />
  </div>
</section>

<script>
  const btn = document.getElementById('hero-copy-btn');
  const cmd = document.getElementById('hero-install-command');
  let resetTimer: ReturnType<typeof setTimeout> | undefined;
  btn?.addEventListener('click', async () => {
    if (resetTimer) clearTimeout(resetTimer);
    try {
      await navigator.clipboard.writeText(cmd?.textContent ?? '');
      btn.textContent = 'Copied';
    } catch { btn.textContent = 'Failed'; }
    resetTimer = setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  });
</script>
