---
import StatRow from './StatRow.astro';
import SpecGrid from './SpecGrid.astro';
import themes from '../../data/themes.generated.json';
import printers from '../../data/printers.generated.json';
import backends from '../../data/backends.generated.json';
import whatsnew from '../../data/whatsnew.generated.json';

// repo.generated.json is not committed; a build that skipped prebuild has none.
const repo = Object.values(
  import.meta.glob<{ commitsDisplay: string | null }>('../../data/repo.generated.json', { eager: true, import: 'default' }),
)[0];

const [major, minor] = whatsnew.version.split('.').map(Number);

// The announcement shows only while the built docs are the line it announces,
// so a deploy that trails the release tag never announces a version the badge
// beside it does not yet read.
const ANNOUNCED_SERIES = '1.1';
const isLaunch = `${major}.${minor}` === ANNOUNCED_SERIES;
const RELEASE_URL = 'https://github.com/prestonbrown/helixscreen/releases/tag/v1.1.0';
const series = Number.isFinite(major) && Number.isFinite(minor) ? `${major}.${minor}` : null;

const stats = [
  ...(repo?.commitsDisplay ? [{ value: repo.commitsDisplay, label: 'commits since October 2025' }] : []),
  { value: '~15 MB', label: 'resident on an armv7 printer board' },
  { value: String(printers.count), label: 'printers detected automatically' },
];

const spec = [
  { k: 'RAM', v: '~15 MB' },
  { k: 'Disk', v: '~75-115 MB' },
  { k: 'Requires', v: 'Klipper + Moonraker' },
  { k: 'X11 / browser', v: 'not required', tone: 'subtle' as const },
  { k: 'Panels', v: '30+' },
  { k: 'Themes', v: String(themes.length) },
  { k: 'Multi-material', v: String(backends.count) },
  { k: 'License', v: 'GPL-3.0' },
];

const install = 'curl -sSL https://releases.helixscreen.org/install.sh | sh';
---
<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-14">
  <div class="max-w-3xl">
    <p class="ui text-xs uppercase tracking-[0.16em] text-warn mb-5">
      Klipper touch interface{series && ` · ${series}`}
    </p>
    <h1 class="text-4xl md:text-5xl leading-[1.1] max-w-[28ch] mb-5">
      A modern Klipper touchscreen, built around filament and multi-material.
    </h1>
    <p class="text-lg leading-relaxed text-ink-muted max-w-[56ch] mb-8">
      It runs {backends.count} filament systems natively, among them Happy Hare, AFC, ACE, CFS
      and IFS, and tracks every spool with or without Spoolman. It detects your printer
      and lays out a home screen for your display, which you can then rearrange however
      you like. It replaces KlipperScreen or the factory screen in about 15 MB of RAM.
    </p>

    {isLaunch && (
      <p class="text-base leading-relaxed text-ink-muted max-w-[56ch] mb-8 border-l-2 border-l-warn pl-4">
        <strong class="font-semibold text-ink">HelixScreen 1.1 is out.</strong>{' '}
        The home screen is now a square-cell grid you arrange
        yourself, with layouts for ultrawide and portrait panels, and a new Print Status screen
        is built around your printer's picture. A new spool editor writes to the printer's own
        filament system, belt tension and pressure advance have guided screens, and OpenAMS,
        multiple ACE units and Lua plugins are new. Upgrading from 1.0 keeps your settings and
        converts your home layout.
        <span class="block mt-2">
          <a href="/whats-new/" class="text-secondary underline underline-offset-2">What's new</a>
          <span class="mx-2" aria-hidden="true">·</span>
          <a href={RELEASE_URL} class="text-secondary underline underline-offset-2">Release notes on GitHub</a>
        </span>
      </p>
    )}
  </div>

  <SpecGrid rows={spec} />

  <div class="max-w-3xl">
    {/* The command wraps rather than scrolling: a scroll container hides most of
        the URL behind a scrollbar, and the whole point is to read it before
        piping it to a shell. */}
    <div class="mt-8 flex items-start gap-3 border border-hairline border-l-2 border-l-alert rounded-[var(--hx-radius)] bg-overlay px-4 py-3">
      <span class="font-mono text-sm text-ink-muted select-none">$</span>
      <code id="hero-install-command" tabindex="0" class="font-mono text-sm text-ink flex-1 leading-relaxed [overflow-wrap:anywhere]">{install}</code>
      <button id="hero-copy-btn" type="button" aria-live="polite" class="ui text-xs uppercase tracking-[0.1em] text-ink-muted hover:text-ink shrink-0">Copy</button>
    </div>
    <p class="ui text-sm text-ink-muted mt-4">
      Prefer to read first? <a href="/installation/" class="text-secondary underline underline-offset-2">The install guide</a> covers every supported board, plus running the screen on a separate device.
    </p>
  </div>

  <div class="mt-12">
    <StatRow items={stats} />
  </div>
</section>

<script>
  const btn = document.getElementById('hero-copy-btn');
  const cmd = document.getElementById('hero-install-command');
  let resetTimer: ReturnType<typeof setTimeout> | undefined;
  btn?.addEventListener('click', async () => {
    if (resetTimer) clearTimeout(resetTimer);
    try {
      await navigator.clipboard.writeText(cmd?.textContent ?? '');
      btn.textContent = 'Copied';
    } catch { btn.textContent = 'Failed'; }
    resetTimer = setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  });
</script>
