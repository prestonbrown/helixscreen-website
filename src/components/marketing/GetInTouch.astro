---
const routes = [
  {
    intent: 'Something is broken',
    action: 'Open a bug report',
    href: 'https://github.com/prestonbrown/helixscreen/issues/new?template=bug_report.yml',
    external: true,
    note: 'Include your printer model and the log file.',
    fallback: 'No GitHub account? Mail <a href="mailto:bugs@helixscreen.org" class="text-secondary underline underline-offset-2">bugs@helixscreen.org</a> instead.',
  },
  {
    intent: "I want it to do something it doesn't",
    action: 'Open an issue',
    href: 'https://github.com/prestonbrown/helixscreen/issues/new?template=feature_request.yml',
    external: true,
    note: 'Requests are public, so others can add to them.',
  },
  {
    intent: 'I have a question, or want to talk it through',
    action: 'Discuss on Discord',
    href: 'https://discord.gg/RZCT2StKhr',
    external: true,
    note: 'Usually the fastest way to get an answer.',
  },
  {
    intent: 'I want to contribute code',
    action: 'Read CONTRIBUTING.md',
    href: 'https://github.com/prestonbrown/helixscreen/blob/main/CONTRIBUTING.md',
    external: true,
    note: 'Translation fixes, bug fixes and new features are all welcome.',
  },
  {
    intent: 'Anything else',
    action: 'hello@helixscreen.org',
    href: 'mailto:hello@helixscreen.org',
    external: false,
    note: 'Reaches me directly.',
  },
];

interface Props {
  /** `h1` on the standalone /contact/ page, `h2` as a landing-page section. */
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<section id="touch" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-hairline">
  <Heading class="text-3xl leading-tight mb-3">Get in touch</Heading>
  <p class="ui text-sm text-ink-muted mb-8 max-w-[62ch]">
    Most of HelixScreen's features started as someone's request. Use whichever of these
    fits; they all reach me.
  </p>
  <div class="border-t border-hairline">
    {routes.map((r) => (
      <div class="grid md:grid-cols-[1fr_auto] gap-2 md:gap-8 items-baseline py-4 border-b border-hairline">
        <div>
          <p class="text-base text-ink">{r.intent}</p>
          <p class="ui text-xs text-ink-muted mt-1">{r.note}</p>
          {r.fallback && <p class="ui text-xs text-ink-muted mt-1" set:html={r.fallback} />}
        </div>
        {r.external ? (
          <a href={r.href} target="_blank" rel="noopener noreferrer" class="btn btn-strong shrink-0">{r.action}</a>
        ) : (
          <a href={r.href} class="btn btn-strong shrink-0">{r.action}</a>
        )}
      </div>
    ))}
  </div>
  <p class="ui text-xs text-ink-muted mt-6">
    Security issues go to <a href="mailto:security@helixscreen.org" class="text-secondary underline underline-offset-2">security@helixscreen.org</a> instead.
  </p>
</section>
