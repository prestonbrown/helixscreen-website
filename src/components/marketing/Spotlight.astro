---
import { Image } from 'astro:assets';
import backends from '../../data/backends.generated.json';
import ams from '../../assets/images/screenshots/ams-overview.png';
import ercf from '../../assets/images/ams/ercf.svg';
import boxTurtle from '../../assets/images/ams/box_turtle.svg';
import tradrack from '../../assets/images/ams/tradrack.svg';
import threeMs from '../../assets/images/ams/3ms.svg';
import nightOwl from '../../assets/images/ams/night_owl.svg';
import kms from '../../assets/images/ams/kms.svg';
import quattro from '../../assets/images/ams/quattro_box.svg';
import vivid from '../../assets/images/ams/btt_vivid.svg';
import mmx from '../../assets/images/ams/mmx.svg';

const icons = [
  { src: ercf, alt: 'ERCF' }, { src: boxTurtle, alt: 'Box Turtle' },
  { src: tradrack, alt: 'TradRack' }, { src: threeMs, alt: '3MS' },
  { src: nightOwl, alt: 'Night Owl' }, { src: kms, alt: 'KMS' },
  { src: quattro, alt: 'Quattro Box' }, { src: vivid, alt: 'BTT Vivid' },
  { src: mmx, alt: 'MMX' },
];
const url = (s: any) => (typeof s === 'string' ? s : s.src);
---
<section class="border-t border-b border-hairline bg-overlay">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid lg:grid-cols-2 gap-12 items-center">
    <div class="plinth">
      <Image src={ams} alt="Filament system screen for an AFC Box Turtle: four lanes holding PLA, Silk PLA, ASA and PETG, the hub and buffer, and the loaded lane's filament running to the toolhead" widths={[480, 768, 1024]} sizes="(max-width: 1024px) 92vw, 46vw" />
    </div>
    <div>
      <p class="ui text-xs uppercase tracking-[0.16em] text-warn mb-4">Multi-material</p>
      <h2 class="text-3xl leading-tight mb-4">{backends.count} multi-material systems</h2>
      <p class="text-base leading-relaxed text-ink-muted mb-4">
        Happy Hare (ERCF, 3MS, Tradrack, MMU2), AFC (Box Turtle, ViViD), OpenAMS, Anycubic ACE
        Pro with several units, the AD5X's IFS, Creality CFS, the Snapmaker U1 with RFID spool
        recognition, QIDI Box, Bondtech INDX in early support, and tool changers.
      </p>
      <p class="text-base leading-relaxed text-ink-muted mb-4">
        Each unit is drawn as itself, and the filament path shows where the filament is right
        now. Load, unload, tool changes, endless spool and runout recovery all run from the
        screen. Boxes with a dryer show humidity and drying controls. Lanes are written to
        Moonraker's lane_data, so Mainsail, Fluidd and OrcaSlicer see them too.
      </p>
      <p class="text-base leading-relaxed text-ink-muted mb-6">
        I didn't set out to support this many. People kept asking, and the ones who
        owned the hardware sent patches.
      </p>
      <p class="ui text-xs text-ink-muted mb-3">
        Some of the hardware these backends support. Several units work with more than one.
      </p>
      <div class="flex flex-wrap gap-4 items-center">
        {icons.map((i) => (
          <img src={url(i.src)} alt={i.alt} width="34" height="34" class="opacity-60 hover:opacity-100 transition-opacity" />
        ))}
      </div>
    </div>
  </div>
</section>
