---
interface Props { rows: { k: string; v: string; tone?: 'ok' | 'subtle' }[] }
const { rows } = Astro.props;
const toneClass = (t?: string) =>
  t === 'ok' ? 'text-ok' : t === 'subtle' ? 'text-ink-muted' : 'text-ink';

// Every cell sits against a divider rule and needs a gutter, except the first in
// its row, which stays flush with the page margin. Row length changes at the md
// breakpoint, so the two cases are resolved separately.
const padLeft = (i: number) => [
  i % 2 === 0 ? 'pl-0' : 'pl-4',
  i % 4 === 0 ? 'md:pl-0' : 'md:pl-5',
];
---
<div class="grid grid-cols-2 md:grid-cols-4 border-t border-b border-hairline">
  {rows.map((r, i) => (
    <div class:list={[
      'py-4 pr-5',
      ...padLeft(i),
      i % 4 !== 3 && i !== rows.length - 1 && 'md:border-r md:border-hairline',
    ]}>
      <span class="ui block text-xs uppercase tracking-[0.13em] text-ink-muted mb-1.5">{r.k}</span>
      <span class:list={['tabular text-base', toneClass(r.tone)]}>{r.v}</span>
    </div>
  ))}
</div>
