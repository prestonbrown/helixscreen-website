---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt: string; caption: string }
const { image, alt, caption } = Astro.props;
---
<figure>
  <div class="plinth">
    <Image src={image} alt={alt} widths={[480, 768, 1024]} sizes="(max-width: 768px) 92vw, 60vw" />
  </div>
  <figcaption class="ui text-xs text-ink-muted mt-2">{caption}</figcaption>
</figure>
