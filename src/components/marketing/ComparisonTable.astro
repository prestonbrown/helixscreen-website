---
import backends from '../../data/backends.generated.json';
import GuideLinks from './GuideLinks.astro';

const rows = [
  { group: 'Project', guide: [{ href: '/guide/release-notes-1-1/', label: '1.1 Release Notes' }] },
  { k: 'Latest release', me: '1.1.0, Nov 2026', ks: '0.4.8, Oct 2026', gs: '0.0.26-beta, Apr 2024', gsTone: 'no' },
  { group: 'Footprint', guide: [{ href: '/installation/#display-backends-drm-vs-framebuffer', label: 'Display Backends' }, { href: '/installation/#low-memory-systems-pi-3-pi-zero-2-w', label: 'Low Memory Systems' }] },
  { k: 'RAM, armv7',                 me: '~15 MB',                    ks: '~50 MB',       gs: '~15-20 MB' },
  { k: 'Needs a display server (X11 or Wayland)', me: 'no', meTone: 'ok',          ks: 'yes', ksTone: 'no', gs: 'no', gsTone: 'ok' },
  { group: 'Filament', guide: [{ href: '/guide/filament/#supported-filament-systems', label: 'Supported Filament Systems' }, { href: '/guide/filament/#spoolman-integration', label: 'Spoolman Integration' }] },
  { k: 'Multi-material backends',    me: String(backends.count),      ks: 'none', ksTone: 'no', gs: 'none', gsTone: 'no' },
  { k: 'Spoolman',                   me: 'yes', meTone: 'ok',         ks: 'yes', ksTone: 'ok', gs: 'yes', gsTone: 'ok' },
  { group: 'Printing', guide: [{ href: '/guide/printing/#file-preview', label: 'File Preview' }, { href: '/guide/printing/#exclude-object', label: 'Exclude Object' }, { href: '/guide/printing/#queueing-a-print', label: 'Queueing a Print' }, { href: '/guide/printing/#pausing-at-a-layer', label: 'Pausing at a Layer' }] },
  { k: 'Rotatable 3D G-code preview', me: 'yes', meTone: 'ok',        ks: 'thumbnails only', ksTone: 'no', gs: 'thumbnails only', gsTone: 'no' },
  { k: 'Cancel one object mid-print', me: 'yes', meTone: 'ok',        ks: 'yes', ksTone: 'ok', gs: 'no', gsTone: 'no' },
  { k: 'Print queue',                me: 'yes', meTone: 'ok',         ks: 'no', ksTone: 'no', gs: 'no', gsTone: 'no' },
  { k: 'Pause at a chosen layer',    me: 'yes', meTone: 'ok',         ks: 'no', ksTone: 'no', gs: 'no', gsTone: 'no' },
  { group: 'Calibration', guide: [{ href: '/guide/calibration/', label: 'Calibration' }] },
  { k: 'Bed mesh in 3D, rotatable',  me: 'yes', meTone: 'ok',         ks: 'flat map', ksTone: 'no', gs: 'flat grid', gsTone: 'no' },
  { k: 'Input shaper graphs on-device', me: 'yes', meTone: 'ok',      ks: 'no', ksTone: 'no', gs: 'yes', gsTone: 'ok' },
  { k: 'Belt tension tuning',        me: 'yes, guided', meTone: 'ok', ks: 'no', ksTone: 'no', gs: 'yes', gsTone: 'ok' },
  { k: 'Pressure advance test tower', me: 'yes', meTone: 'ok',        ks: 'sets a value', gs: 'sets a value' },
  { k: 'PID and MPC calibration',    me: 'yes', meTone: 'ok',         ks: 'yes', ksTone: 'ok', gs: 'no', gsTone: 'no' },
  { group: 'Interface', guide: [{ href: '/guide/settings/language-time/#language', label: 'Language' }, { href: '/guide/settings/appearance/#built-in-themes', label: 'Built-in Themes' }, { href: '/guide/home-panel/', label: 'Home Panel' }, { href: '/dev/contributing/plugins/', label: 'Plugins' }] },
  { k: 'Languages',                  me: '10',                        ks: '32', ksTone: 'ok', gs: 'English only', gsTone: 'no' },
  { k: 'Themes',                     me: '18, plus custom themes you edit on the screen', meTone: 'ok', ks: '5, plus custom', gs: 'Material in 6 colors, Z-Bolt' },
  { k: 'Home screen you arrange',    me: 'widget grid', meTone: 'ok', ks: 'menu items', gs: 'fixed layout', gsTone: 'no' },
  { k: 'Ultrawide and portrait layouts', me: 'yes', meTone: 'ok',     ks: 'portrait only', ksTone: 'no', gs: 'rotation only', gsTone: 'no' },
  { k: 'Plugins',                    me: 'Lua, sandboxed', meTone: 'ok', ks: 'Python addons', gs: 'no', gsTone: 'no' },
  { group: 'Remote', guide: [{ href: '/guide/settings/updates/', label: 'Updates' }, { href: '/guide/install-esp32/', label: 'K-Touch' }, { href: '/guide/screen-sharing/', label: 'Screen Sharing' }, { href: '/installation/#android-app-experimental', label: 'Android App' }] },
  { k: 'In-app updates',             me: 'signed, stable and beta channels', meTone: 'ok', ks: 'Moonraker update manager (git)', gs: 'SSH script; stable and nightly builds' },
  { k: 'Portable Wi-Fi screen, no Linux computer (ESP32)', me: 'BTT K-Touch, beta', meTone: 'ok', ks: 'no, needs Linux', ksTone: 'no', gs: 'no, needs Linux', gsTone: 'no' },
  { k: 'Screen in a browser',        me: 'yes', meTone: 'ok',         ks: 'via VNC', gs: 'no', gsTone: 'no' },
  { k: 'Android app',                me: 'yes', meTone: 'ok',         ks: 'via XServer-XSDL', gs: 'yes', gsTone: 'ok' },
];
// 'ok' -> green; 'no' -> muted (a value that isn't a clean win); otherwise the
// column's own default (bright ink for HelixScreen, muted for the others).
const tone = (t: string | undefined, fallback: string) =>
  t === 'ok' ? 'text-ok' : t === 'no' ? 'text-ink-muted' : fallback;
---
<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
  <h2 class="text-2xl mb-2">HelixScreen, KlipperScreen and GuppyScreen compared</h2>
  <p class="ui text-sm text-ink-muted mb-6">
    RAM figures are resident set size, measured on a FlashForge Adventurer 5M Pro, not install size.
    Competitor cells come from each project's public repository and docs as of November 2026.
  </p>
  <div class="overflow-x-auto">
    <table class="w-full border-collapse font-mono text-sm min-w-[560px]">
      <thead>
        <tr>
          <th scope="col" class="text-left ui text-xs uppercase tracking-[0.13em] text-ink-muted font-normal pb-3 pr-4 border-b border-hairline w-[38%]"><span class="sr-only">Feature</span></th>
          <th scope="col" class="text-left ui text-xs uppercase tracking-[0.13em] text-ink font-normal pb-3 px-4 border-b border-hairline">HelixScreen</th>
          <th scope="col" class="text-left ui text-xs uppercase tracking-[0.13em] text-ink-muted font-normal pb-3 px-4 border-b border-hairline">KlipperScreen</th>
          <th scope="col" class="text-left ui text-xs uppercase tracking-[0.13em] text-ink-muted font-normal pb-3 px-4 border-b border-hairline">GuppyScreen</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => r.group ? (
          <tr>
            <th scope="colgroup" colspan="4" class="text-left ui text-xs text-ink-muted font-normal pt-6 pb-2 border-b border-hairline">
              <span class="uppercase tracking-[0.13em] mr-4">{r.group}</span>
              {r.guide && <GuideLinks class="inline" links={r.guide} />}
            </th>
          </tr>
        ) : (
          <tr>
            <th scope="row" class="text-left ui text-sm font-normal text-ink py-3 pr-4 border-b border-hairline/40">{r.k}</th>
            <td class:list={['py-3 px-4 border-b border-hairline/40 tabular', tone(r.meTone, 'text-ink')]}>{r.me}</td>
            <td class:list={['py-3 px-4 border-b border-hairline/40 tabular', tone(r.ksTone, 'text-ink-muted')]}>{r.ks}</td>
            <td class:list={['py-3 px-4 border-b border-hairline/40 tabular', tone(r.gsTone, 'text-ink-muted')]}>{r.gs}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
