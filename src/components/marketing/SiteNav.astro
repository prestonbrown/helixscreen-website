---
import { Image } from 'astro:assets';
import SiteSearch from './SiteSearch.astro';
import ThemeSwitcher from '../ThemeSwitcher.astro';
import logo from '../../assets/images/logo/helix-icon-64.png';
import whatsnew from '../../data/whatsnew.generated.json';
import { DOC_VERSIONS, docsPrefix } from '../../data/doc-versions.mjs';

// Each option opens that version's docs. The stable entry names the exact
// release; the others have no release number at build time, only their line.
const versionOptions = [
  { href: '/guide/', label: `${whatsnew.version} stable` },
  ...DOC_VERSIONS.others.map((v) => ({
    href: `${docsPrefix(v.slug)}/guide/`,
    label: `${v.slug} ${v.prerelease ? 'beta' : ''}`.trim(),
  })),
];
---
<header id="site-nav" class="sticky top-0 z-50 bg-canvas">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-3 sm:gap-6 h-14">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <Image src={logo} alt="" width={24} class="h-6 w-auto" />
      <span class="font-semibold text-ink">HelixScreen</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden min-[1200px]:flex items-center gap-4 lg:gap-5 ui text-sm text-ink-muted whitespace-nowrap">
      <a href="/installation/" class="hover:text-ink">Install</a>
      <a href="/guide/getting-started/" class="hover:text-ink">Docs</a>
      <a href="/printers/" class="hover:text-ink">Printers</a>
      <a href="/installer/" class="hover:text-ink">Easy installer</a>
      <a href="/flash/" class="hover:text-ink">Flash K-Touch</a>
      <a href="/whats-new/" class="hover:text-ink">What's new</a>
      <a href="/contact/" class="hover:text-ink">Contact</a>
    </nav>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <SiteSearch />
      <ThemeSwitcher />
      <label class="hidden sm:inline-flex">
        <span class="sr-only">Documentation version</span>
        <select
          id="version-select"
          class="ui text-xs text-ink bg-transparent border border-alert rounded-[var(--hx-radius)] px-1.5 py-1 tabular cursor-pointer"
        >
          {versionOptions.map((o, i) => <option value={o.href} selected={i === 0}>{o.label}</option>)}
        </select>
      </label>

      <!-- Hidden below sm, where the bar is already full; the mobile menu carries
           it at those widths instead, so it is never rendered twice. -->
      <a
        href="https://github.com/prestonbrown/helixscreen"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline ui text-sm text-ink-muted hover:text-ink transition-colors"
      >Source</a>

      <!-- Mobile hamburger -->
      <button
        id="nav-toggle"
        type="button"
        class="min-[1200px]:hidden text-ink-muted hover:text-ink transition-colors p-2 -mr-2"
        aria-label="Toggle navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="close-icon" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden min-[1200px]:hidden border-t border-hairline bg-overlay">
    <nav class="px-4 sm:px-6 py-4 flex flex-col gap-1 ui text-sm">
      <a href="/installation/" class="text-ink-muted hover:text-ink transition-colors py-2">Install</a>
      <a href="/guide/getting-started/" class="text-ink-muted hover:text-ink transition-colors py-2">Docs</a>
      <a href="/printers/" class="text-ink-muted hover:text-ink transition-colors py-2">Printers</a>
      <a href="/installer/" class="text-ink-muted hover:text-ink transition-colors py-2">Easy installer</a>
      <a href="/flash/" class="text-ink-muted hover:text-ink transition-colors py-2">Flash K-Touch</a>
      <a href="/whats-new/" class="text-ink-muted hover:text-ink transition-colors py-2">What's new</a>
      <a href="/contact/" class="text-ink-muted hover:text-ink transition-colors py-2">Contact</a>
      <a
        href="https://github.com/prestonbrown/helixscreen"
        target="_blank"
        rel="noopener noreferrer"
        class="sm:hidden text-ink-muted hover:text-ink transition-colors py-2"
      >Source</a>
    </nav>
  </div>

  <hr class="rule opacity-0 transition-opacity" id="nav-rule" />
</header>

<script>
  // Hairline bottom border fades in once the page has scrolled past the header.
  const rule = document.getElementById('nav-rule');
  const onScroll = () => {
    if (rule) rule.style.opacity = window.scrollY > 8 ? '1' : '0';
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // The version picker is a jump to that version's docs, so it always rests on
  // stable; a back navigation restores the page from cache with the old choice.
  const versionSelect = document.getElementById('version-select') as HTMLSelectElement | null;
  if (versionSelect) {
    versionSelect.addEventListener('change', () => { window.location.href = versionSelect.value; });
    window.addEventListener('pageshow', () => { versionSelect.selectedIndex = 0; });
  }

  // Mobile menu toggle
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggle && menu && hamburgerIcon && closeIcon) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>
