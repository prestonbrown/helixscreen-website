    {
      "id": "qidi_max_4",
      "name": "Qidi Max 4",
      "manufacturer": "Qidi",
      "aliases": [],
      "notes": "Linux framebuffer display. Detection + preset are community-tested on-device; the QIDI Box is detected/read via the qidi_box backend, but Max 4 box CONTROL diverges from the Q2/Plus 4 -- eject/unload uses the multi_color_controller dialect (MULTI_COLOR_BOX_UNLOAD SLOT=slotN), not the shared box_stepper FORCE_MOVE primitive (rejected as 'Invalid pin value'). Per-model box dispatch tracked in prestonbrown/helixscreen#1083."
    },
    {
      "id": "qidi_plus_4",
      "name": "Qidi Plus 4",
      "manufacturer": "Qidi",
      "aliases": [],
      "notes": "Stock display is a TJC HMI on serial bus. Not supported without screen replacement (HDMI/DSI touchscreen required). Compatible with the QIDI Box filament changer (4-slot hub-style, chainable to 16)."
    },
    {
      "id": "qidi_q1_pro",
      "name": "Qidi Q1 Pro",
      "manufacturer": "Qidi",
      "aliases": [],
      "notes": "Stock display is a TJC HMI (TJC4827X243_011) on serial bus at 480x272. Not supported without screen replacement."
    },
    {
      "id": "qidi_q2",
      "name": "Qidi Q2",
      "manufacturer": "Qidi",
      "aliases": [],
      "notes": "Compatible with the QIDI Box filament changer (4-slot hub-style, chainable to 16)."
    },
    {
      "id": "qidi_x_max_3",
      "name": "Qidi X-Max 3",
      "manufacturer": "Qidi",
      "aliases": [],
      "notes": "Stock display is a TJC HMI on serial bus. Not supported without screen replacement (HDMI/DSI touchscreen required)."
    },
    {
      "id": "qidi_x_plus_3",
      "name": "Qidi X-Plus 3",
      "manufacturer": "Qidi",
      "aliases": [],
      "notes": "Stock display is a TJC HMI on serial bus. Not supported without screen replacement (HDMI/DSI touchscreen required)."
    },
    {
      "id": "qidi_x_smart_3",
      "name": "Qidi X-Smart 3",
      "manufacturer": "Qidi",
      "aliases": [],
      "notes": "Smallest of the Qidi 3-series (175x180x170 build volume, passive enclosure, no active chamber heater). Stock display is a TJC HMI on serial bus at 480x272 -- on-device install requires screen replacement. Works without modification as a remote target when HelixScreen runs on a separate touchscreen."
    },
    {
      "id": "ratrig_vcore3",
      "name": "RatRig V-Core 3",
      "manufacturer": "RatRig",
      "aliases": [],
      "notes": "RatOS CoreXY with 3 independent Z (z_tilt). V-Core 4 / IDEX / V-Core Pro hosts are excluded so they resolve to their own entries; a renamed-host V-Core 4 still falls back here."
    },
    {
      "id": "ratrig_vcore4",
      "name": "RatRig V-Core 4",
      "manufacturer": "RatRig",
      "aliases": [],
      "notes": "RatOS CoreXY successor to V-Core 3. Distinguished from V-Core 3 by hostname; V-Core 4 Hybrid (non-IDEX) also resolves here. Runtime Z-stepper count is board-dependent so it is not used as a signal."
    },
    {
      "id": "ratrig_vcore_idex",
      "name": "RatRig V-Core 4 IDEX",
      "manufacturer": "RatRig",
      "aliases": [],
      "notes": "RatOS IDEX (dual carriage) on the RatOS-exclusive 'ratos_hybrid_corexy' kinematics. V-Core 3 IDEX shares this signature; refined by hostname when present. Reuses the V-Core 4 image (IDEX is a V-Core 4 dual-toolhead variant)."
    },
    {
      "id": "ratrig_vcore_pro",
      "name": "RatRig V-Core Pro",
      "manufacturer": "RatRig",
      "aliases": [],
      "notes": "Older RatOS CoreXY (V-Core Pro 1.x, discontinued). Shares the 3-Z + z_tilt fingerprint with V-Core 3; identified by hostname. Reuses the V-Core 3 image (visual predecessor; no Pro-specific photo available)."
    },
    {
      "id": "ratrig_vminion",
      "name": "RatRig V-Minion",
      "manufacturer": "RatRig",
      "aliases": [],
      "notes": "RatOS Cartesian printer (the only Cartesian RatOS model), ~180mm. Cartesian kinematics plus the RatOS marker identify it even with a renamed host."
    },
